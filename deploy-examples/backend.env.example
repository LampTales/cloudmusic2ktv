CLOUDMUSIC2KTV_BACKEND_IMAGE=docker.io/lamptales/cloudmusic2ktv-backend:latest
# Replace the loopback default with the backend host's private/VPN address.
CLOUDMUSIC2KTV_BACKEND_BIND_ADDRESS=127.0.0.1
# Host port published for the frontend node; the container still listens on 7860.
CLOUDMUSIC2KTV_BACKEND_PORT=7860
# Use /ktv when the public site is mounted at https://example.com/ktv/.
CLOUDMUSIC2KTV_BASE_PATH=
# Trust X-Forwarded-* only because this deployment puts a controlled frontend proxy in front.
CLOUDMUSIC2KTV_TRUST_PROXY=1
# Keep disabled for formal HTTPS deployment.
CLOUDMUSIC2KTV_ALLOW_INSECURE_COOKIE_IMPORT=0
# Normally empty because clients use the same-origin frontend proxy.
CLOUDMUSIC2KTV_CORS_ORIGINS=
CLOUDMUSIC2KTV_SESSION_DAYS=90
CLOUDMUSIC2KTV_MEDIA_URL_TTL_SECONDS=3600
CLOUDMUSIC2KTV_PLAYLIST_CACHE_TTL_SECONDS=21600
CLOUDMUSIC2KTV_PLAYLIST_CACHE_MAX_ENTRIES=32
# Host model directory mounted read-only at /models in the backend container.
# It must contain the Hugging Face cache layout described in README.md.
LYRIC_MODELS_DIR=/var/lib/cloudmusic2ktv/models
LYRIC_DEMUCS_MODEL_PATH=/models/huggingface/hub/models--adefossez--HTDemucs/snapshots/cbc8a9b1a87023b7fd74e7b3412e6321c0eab003
LYRIC_CTC_MODEL_PATH=/models/huggingface/hub/models--NextFire--mms-300m-ForcedAligner-karaoke-ja-Latn/snapshots/2ab2b5f46539ee284703c281f286b01d2410ee12
LYRIC_DEVICE=cpu
# Vocal boundary validation; acoustic verification is experimental and off by default.
LYRIC_OFFSET_BOUNDARY_CHECK=true
LYRIC_OFFSET_SILENCE_MS=2000
LYRIC_OFFSET_SUSTAIN_MS=200
LYRIC_OFFSET_BOUNDARY_TOLERANCE_MS=800
LYRIC_OFFSET_ACOUSTIC_VERIFY=false
LYRIC_OFFSET_ACOUSTIC_MIN_MARGIN=0.15
LYRIC_CTC_SCORE_THRESHOLD=-2.25
LYRIC_CTC_COVERAGE_THRESHOLD=0.8
LYRIC_CTC_MARGIN_MS=500
LYRIC_CTC_ACTIVITY_MARGIN_MS=120
LYRIC_CTC_ACTIVITY_CONFIDENCE_THRESHOLD=0.45
# Legacy alias accepted by the backend when the canonical variable is empty.
# LYRIC_ACTIVITY_CONFIDENCE_THRESHOLD=0.45
LYRIC_ACTIVITY_PROJECTION_CONFIDENCE_THRESHOLD=0.35
CLOUDMUSIC2KTV_MODEL_SWEEP_GAP_THRESHOLD_MS=200
# Optional; if omitted, a stable key is generated in docker-data/instance/media_signing.key.
# CLOUDMUSIC2KTV_MEDIA_SIGNING_KEY=
