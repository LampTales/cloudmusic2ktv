# Empty when the service is served at the domain root or directly on a LAN.
CLOUDMUSIC2KTV_BASE_PATH=

# Set to 1 only when a trusted reverse proxy overwrites forwarded headers.
CLOUDMUSIC2KTV_TRUST_PROXY=0

# 0.0.0.0 for LAN testing; use 127.0.0.1 when only a local reverse proxy
# should reach the container.
CLOUDMUSIC2KTV_BIND_ADDRESS=0.0.0.0
