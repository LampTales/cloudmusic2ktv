CLOUDMUSIC2KTV_BACKEND_IMAGE=ghcr.io/lamptales/cloudmusic2ktv-backend:latest
# Bind only to the backend host's private/VPN address, for example 10.147.17.23.
CLOUDMUSIC2KTV_BACKEND_BIND_ADDRESS=127.0.0.1
# Use /ktv when the public site is mounted at https://example.com/ktv/.
CLOUDMUSIC2KTV_BASE_PATH=
